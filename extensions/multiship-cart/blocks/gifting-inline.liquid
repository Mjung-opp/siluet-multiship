{%- comment -%}
  Siluet gifting, inline version (Gifting page). Works on its own; the "Siluet gifting" app embed adds the sheet everywhere else.
{%- endcomment -%}
<div class="siluet-ms-inline" data-siluet-ms-inline data-title="{{ block.settings.heading | escape }}" data-intro="{{ block.settings.intro | escape }}"></div>

<script type="application/json" id="siluet-ms-config">
  {
    "root": {{ routes.root_url | json }},
    "shopUrl": {{ block.settings.shop_url | default: '/collections/shop' | json }},
    "currency": {{ cart.currency.iso_code | json }},
    "country": {{ localization.country.iso_code | json }},
    "email": {{ customer.email | json }},
    "countries": [{%- for c in localization.available_countries -%}{"code":{{ c.iso_code | json }},"name":{{ c.name | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
  }
</script>
{{ 'gifting.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gifting.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Send to several people",
  "target": "section",
  "enabled_on": { "templates": ["page", "cart"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Who is it for?" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Choose who gets what. Each person gets their own parcel and tracking." },
    { "type": "url", "id": "shop_url", "label": "Link when the bag is empty" }
  ]
}
{% endschema %}
